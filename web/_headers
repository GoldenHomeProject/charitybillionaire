# Cloudflare Pages headers — applied to every route.
# Content-Security-Policy keeps all executable code same-origin so no third-party
# CDN can sit on the transaction-signing path. ethers is vendored under /vendor/.
# Wallet signing happens through the injected extension (window.ethereum), which is
# not governed by these directives, so this does not affect MetaMask/Coinbase signing.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://mainnet.base.org https://base-rpc.publicnode.com https://base.llamarpc.com https://base.drpc.org; img-src 'self' data:; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  # Always revalidate app logic against the origin (cheap 304 via ETag when unchanged).
  # On a live money site a code fix must reach every visitor on their next load, not sit
  # behind a multi-hour browser cache. Explicit max-age=0 overrides Cloudflare Pages' default
  # 14400s asset cache; version-named immutable assets are excepted below.
  Cache-Control: public, max-age=0, must-revalidate

# /vendor/ files are version-named (e.g. ethers-6.16.0.js); their bytes never change for a
# given name, so they're safe to cache hard. Bumping a dep means a new filename + a CSP/import
# update, which busts this automatically.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# When enabling mainnet / WalletConnect, extend the CSP above:
#   - connect-src: add the mainnet RPC host, and wss://relay.walletconnect.com (WC relay)
#   - script-src: keep 'self' and add the *vendored* WalletConnect path (do NOT add esm.sh)
